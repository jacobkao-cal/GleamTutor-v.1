{
  "name": "gleam-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "tracer:setup": "node tracer-node/setup.mjs",
    "tracer:test": "vitest run --config tracer-node/vitest.config.ts",
    "tracer:typecheck": "tsc -p tracer-node/tsconfig.json && tsc -p e2e/tsconfig.json",
    "tracer:trace": "vite-node tracer-node/cli.ts --",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "tracer:audit": "vite-node tracer-node/audit.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "acorn": "^8.14.0",
    "esbuild": "0.21.5",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
