    "../src/tracer/runtime.ts",
    "../src/tracer/traceGleam.ts",
    "../src/tracer/toTraceResult.ts",
    "../src/tracer/outcome.ts",
    "../src/tracer/traceable.ts",
    "compiler.ts",
    "runner.ts",
    "nodeRuntime.ts",
    "cli.ts",
    "tests/helpers.ts",
    "tests/units.test.ts",
    "tests/trace.test.ts",
    "tests/engine.test.ts",
    "tests/sandbox.test.ts",
    "vitest.config.ts"
  ]
